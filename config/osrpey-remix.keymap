#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <250>;
};

/ {
    combos {
        compatible = "zmk,combos";

        insert {
            bindings = <&kp INSERT>;
            key-positions = <40 41>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <12 13>;
            layers = <0>;
        };

        go_to_adjust {
            bindings = <&mo 2>;
            key-positions = <36 38 37>;
        };
    };

    macros {
        select_line: select_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
            label = "SELECT_LINE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R         &kp T      &kp Y      &kp U          &kp I       &kp O    &kp P      &kp LEFT_BRACKET
&kp LCTRL       &kp A  &kp S  &kp D         &kp F         &kp G      &kp H      &kp J          &kp K       &kp L    &kp SEMI   &mt RCTRL SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C         &kp V         &kp B      &kp N      &kp M          &kp COMMA   &kp DOT  &kp SLASH  &mt RIGHT_SHIFT ESCAPE
                              &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE  &kp ENTER  &kp BACKSPACE  &kp DELETE
            >;
        };

        default_layer_ext {
            bindings = <
&kp GRAVE  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &kp INSERT  &kp RIGHT_BRACKET
&trans     &trans  &trans  &trans  &trans  &trans  &kp END   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp DELETE  &kp NON_US_BACKSLASH
&trans     &trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans           &trans      &trans
                           &trans  &trans  &trans  &trans    &trans          &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&none  &none  &none  &none   &bootloader  &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none  &bt BT_CLR
&none  &none  &none  &none   &none        &none   &none         &none         &none         &none  &none  &none
&none  &none  &none  &none   &none        &none   &none         &sys_reset    &none         &none  &none  &none
                     &trans  &trans       &trans  &trans        &trans        &trans
            >;
        };
    };
};
