#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <250>;
};

/ {
    combos {
        compatible = "zmk,combos";

        insert {
            bindings = <&kp INSERT>;
            key-positions = <40 41>;
        };

        select_line {
            bindings = <&select_line>;
            key-positions = <24 25>;
            layers = <0>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <12 13>;
            layers = <0>;
        };

        go_to_adjust {
            bindings = <&mo 3>;
            key-positions = <36 38 37>;
        };

        toggle_nav_layer {
            bindings = <&tog 4>;
            key-positions = <0 1>;
        };
    };

    macros {
        select_line: select_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
            label = "SELECT_LINE";
        };
    };

    behaviors {
        home_left_arrow: home_left_arrow {
            compatible = "zmk,behavior-mod-morph";
            label = "HOME_LEFT_ARROW";
            bindings = <&kp LEFT_ARROW>, <&kp HOME>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        end_right_arrow: end_right_arrow {
            compatible = "zmk,behavior-mod-morph";
            label = "END_RIGHT_ARROW";
            bindings = <&kp RIGHT_ARROW>, <&kp END>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        page_up_up_arrow: page_up_up_arrow {
            compatible = "zmk,behavior-mod-morph";
            label = "PAGE_UP_UP_ARROW";
            bindings = <&kp UP_ARROW>, <&kp PAGE_UP>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };

        page_down_down_arrow: page_down_down_arrow {
            compatible = "zmk,behavior-mod-morph";
            label = "PAGE_DOWN_DOWN_ARROW";
            bindings = <&kp DOWN_ARROW>, <&kp PAGE_DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R         &kp T        &kp Y        &kp U          &kp I         &kp O    &kp P                &mt RIGHT_BRACKET LEFT_BRACKET
&kp LCTRL       &kp A  &kp S  &kp D         &kp F         &kp G        &kp H        &kp J          &kp K         &kp L    &kp SEMI             &mt RCTRL SQT
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C         &kp V         &kp B        &kp N        &kp M          &kp COMMA     &kp DOT  &mt BACKSLASH SLASH  &mt RIGHT_SHIFT ESCAPE
                              &kp LEFT_WIN  &kp LEFT_ALT  &lt 1 SPACE  &lt 2 ENTER  &kp BACKSPACE  &lt 4 DELETE
            >;
        };

        left_layer {
            bindings = <
&kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET         &kp AMPERSAND      &kp ASTERISK          &none                  &none      &none
&trans     &none            &none        &none     &none       &none        &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS  &kp EQUAL
&trans     &none            &none        &none     &none       &none        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LESS_THAN         &kp GREATER_THAN       &kp SLASH  &kp NON_US_BACKSLASH
                                         &trans    &trans      &kp SPACE    &kp SPACE         &trans             &trans
            >;

            display-name = "Left";
        };

        right_layer {
            bindings = <
&none   &none  &none  &none   &none   &none      &kp MINUS  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp SLASH     &kp NUMBER_0
&trans  &none  &none  &none   &none   &none      &kp PLUS   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK  &trans
&trans  &none  &none  &none   &none   &none      &kp EQUAL  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &trans
                      &trans  &trans  &kp SPACE  &kp SPACE  &trans        &trans
            >;

            label = "Right";
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&none  &none  &none  &none   &bootloader  &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none  &bt BT_CLR
&none  &none  &none  &none   &none        &none   &none         &none         &none         &none  &none  &none
&none  &none  &none  &none   &none        &none   &none         &sys_reset    &none         &none  &none  &none
                     &trans  &trans       &trans  &trans        &trans        &trans
            >;
        };

        nav_layer {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp N7  &kp N8            &kp NUMBER_9           &kp NUMBER_0      &none
&trans  &none         &none         &none         &none         &none   &none         &none   &none             &page_up_up_arrow      &none             &none
&trans  &none         &none         &none         &none         &none   &none         &none   &home_left_arrow  &page_down_down_arrow  &end_right_arrow  &trans
                                    &trans        &trans        &trans  &trans        &trans  &trans
            >;

            label = "Navigation";
        };
    };
};
